root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts,java}]
indent_size = 4
max_line_length = off

[*.{dart,yaml,yml,json,toml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{png,ico,jar,gif,jpg,jpeg,webp}]
charset = unset
