<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug network policy. IPTV streams are frequently served over plain HTTP,
    so cleartext stays enabled; user certificates are trusted only in debug
    builds (the release config is generated without them).
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
