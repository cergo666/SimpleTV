<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer rules; keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="stv.xml" />
        <exclude
            domain="file"
            path="sources" />
        <exclude
            domain="file"
            path="epg.db" />
        <exclude
            domain="file"
            path="epg_new.db" />
        <exclude
            domain="file"
            path="epg_cache" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="stv.xml" />
        <exclude
            domain="file"
            path="sources" />
        <exclude
            domain="file"
            path="epg.db" />
        <exclude
            domain="file"
            path="epg_new.db" />
        <exclude
            domain="file"
            path="epg_cache" />
    </device-transfer>
</data-extraction-rules>
