<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV launcher banner (320x180dp, 16:9).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:width="320dp"
  android:height="180dp"
  tools:ignore="VectorRaster">
  <item>
    <shape android:shape="rectangle">
      <size
        android:width="320dp"
        android:height="180dp" />
      <gradient
        android:angle="135"
        android:startColor="#070B14"
        android:endColor="#192238" />
      <stroke
        android:width="1dp"
        android:color="#26324D" />
    </shape>
  </item>
  <item
    android:gravity="bottom"
    android:height="4dp">
    <shape android:shape="rectangle">
      <gradient
        android:angle="0"
        android:startColor="#5B4FE8"
        android:endColor="#8B5CF6" />
    </shape>
  </item>
  <item
    android:drawable="@drawable/ic_launcher_foreground"
    android:gravity="center"
    android:width="216dp"
    android:height="216dp" />
</layer-list>
